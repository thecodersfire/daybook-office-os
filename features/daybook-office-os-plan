#!/usr/bin/env bash
set -euo pipefail
mkdir -p "$HOME/Documents/daybook-office-os-session-plans"
file="$HOME/Documents/daybook-office-os-session-plans/plan-$(date +%Y%m%d-%H%M%S).md"
{
 printf '# daybook-office-os session plan\n\n'
 printf 'Created: %s\n\n' "$(date -Is)"
 printf 'Purpose: everyday office work\n\n## Prompts\n'
 printf '%s\n' '- What question or topic are you studying?' '- What is one measurable learning goal?' '- Which sources or materials will you use?'
 printf '\n## Notes\n'
} > "$file"
nano "$file"
printf 'Saved locally: %s\n' "$file"
